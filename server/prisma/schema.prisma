generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
  SUPPORT
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ConversationStatus {
  OPEN
  RESOLVED
}

enum MessageSenderRole {
  CUSTOMER
  ADMIN
}

enum MessageStatus {
  SENT
  DELIVERED
  SEEN
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String? // null for OAuth-only accounts
  role            Role      @default(CUSTOMER)
  avatarUrl       String?
  phone           String?
  dateOfBirth     DateTime?
  gender          Gender?
  googleId        String?   @unique
  facebookId      String?   @unique
  emailVerified   Boolean   @default(false)
  otpCode         String?
  otpExpiresAt    DateTime?
  resetToken      String?
  resetTokenExpiresAt DateTime?
  status          String    @default("active") // active | blocked
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  wishlist        WishlistItem[]
  notifications   Notification[]
  cartItems       CartItem[]
  recentlyViewed  RecentlyViewed[]
  conversation    Conversation?
}

// One support conversation per customer — admins reply into it, live via socket.io.
model Conversation {
  id            String             @id @default(cuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id])
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  messages      Message[]

  @@index([status, lastMessageAt])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole     MessageSenderRole
  senderId       String
  content        String            @db.Text
  attachmentUrl  String?
  status         MessageStatus     @default(SENT)
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  icon      String? // emoji or icon key, shown for main categories
  image     String? // subcategory thumbnail
  banner    String? // main category page hero banner (legacy, single image)
  bannerImages Json? // subcategory hero carousel — array of image URLs (up to 3)
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")

  products  Product[]

  @@index([parentId])
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  logoUrl     String?
  banner      String?
  featured    Boolean   @default(false)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  products    Product[]
}

model Product {
  id               String    @id @default(cuid())
  name             String
  subtitle         String?
  slug             String    @unique
  shortDescription String?   @db.Text
  description      String    @db.Text
  richContent      String?   @db.LongText // rich HTML body
  price            Decimal   @db.Decimal(10, 2)
  oldPrice         Decimal?  @db.Decimal(10, 2)
  deliveryCharge   Decimal   @default(0) @db.Decimal(10, 2)
  vat              Decimal   @default(0) @db.Decimal(10, 2)
  stock            Int       @default(0)
  sku              String?   @unique
  productCode      String?
  weight           Float?
  material         String?
  warranty         String?
  returnPolicy     String?   @db.Text
  thumbnail        String?
  images           Json // string[]
  video            String?
  colors           Json? // { name, hex }[]
  sizes            Json? // string[]
  tags             Json? // string[]
  rating           Float     @default(0)
  reviewCount      Int       @default(0)
  isActive         Boolean   @default(true)
  isFeatured       Boolean   @default(false)
  isBestSeller     Boolean   @default(false)
  isNewArrival     Boolean   @default(false)
  seoTitle         String?
  seoDescription   String?   @db.Text
  metaKeywords     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id])
  brandId          String
  brand            Brand     @relation(fields: [brandId], references: [id])

  reviews          Review[]
  wishlistedBy     WishlistItem[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  viewedBy         RecentlyViewed[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@index([isNewArrival])
}

model Review {
  id          String        @id @default(cuid())
  rating      Int
  title       String
  body        String        @db.Text
  status      ReviewStatus  @default(PENDING)
  verified    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  userId      String
  user        User          @relation(fields: [userId], references: [id])
  productId   String
  product     Product       @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Address {
  id          String   @id @default(cuid())
  label       String   @default("Home") // Home | Office | Other
  fullName    String
  phone       String
  division    String
  district    String
  upazila     String
  postalCode  String
  fullAddress String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CartItem {
  id         String   @id @default(cuid())
  quantity   Int      @default(1)
  color      String?
  size       String?
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId, color, size])
}

model WishlistItem {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model RecentlyViewed {
  id         String   @id @default(cuid())
  viewedAt   DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

model Order {
  id              String        @id @default(cuid())
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  shipping        Decimal       @default(0) @db.Decimal(10, 2)
  tax             Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  couponCode      String?
  shippingAddress Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  userId          String
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]

  @@index([userId])
}

model OrderItem {
  id         String   @id @default(cuid())
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)
  color      String?
  size       String?

  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
}

model Coupon {
  id           String   @id @default(cuid())
  code         String   @unique
  type         String // percent | fixed
  discount     Float
  maxUses      Int?
  usageCount   Int      @default(0)
  active       Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  link      String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SearchPlaceholder {
  id        String   @id @default(cuid())
  text      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton row (fixed id) holding storefront-wide toggles admin can edit.
model StoreSettings {
  id                     String   @id @default("store")
  freeDeliveryEnabled    Boolean  @default(false)
  freeDeliveryThreshold  Int      @default(3000)

  // Product page trust badges (ফ্রি শিপিং / রিটার্ন / নিরাপদ পেমেন্ট).
  shippingBadgeTitle     String   @default("ফ্রি শিপিং")
  shippingBadgeDesc      String   @default("৭৫ ডলারের বেশি অর্ডারে")
  returnBadgeTitle       String   @default("৩০ দিনের রিটার্ন")
  returnBadgeDesc        String   @default("ঝামেলামুক্ত")
  paymentBadgeTitle      String   @default("নিরাপদ পেমেন্ট")
  paymentBadgeDesc       String   @default("১০০% সুরক্ষিত")

  // Shop page header — 3 rotating tagline sentences (typewriter effect).
  shopSubtitle1          String   @default("আমাদের প্রিমিয়াম ফ্যাশন সংগ্রহ দেখুন।")
  shopSubtitle2          String   @default("সেরা দামে সেরা পণ্য, এখনই কিনুন।")
  shopSubtitle3          String   @default("প্রতিদিন নতুন কালেকশন যোগ হচ্ছে।")

  // Home page flash-sale countdown — admin can disable, set, or extend the deadline.
  flashSaleEnabled       Boolean   @default(true)
  flashSaleEndsAt        DateTime?

  // Footer — admin-managed social/contact links.
  facebookUrl            String?
  instagramUrl           String?
  whatsappNumber         String?
  messengerUrl           String?

  updatedAt              DateTime @updatedAt
}

// Singleton row — the floating promotional popup shown on the home page.
model PromoPopup {
  id            String    @id @default("promo-popup")
  enabled       Boolean   @default(false)
  title         String    @default("অফার শীঘ্রই শেষ হচ্ছে")
  message       String    @default("সীমিত সময়ের জন্য বিশেষ ছাড় — এখনই কেনাকাটা করুন।")
  imageUrl      String?
  buttonText    String?
  buttonLink    String?
  delaySeconds  Int       @default(3)
  startAt       DateTime?
  endAt         DateTime?
  updatedAt     DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  type      String // order | promo | wishlist | system
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}
